foreach(INPUT REFERENCE CHANGED ADDED REMOVED RENAMED VULNERABLE FIXED INDEPENDENT UNRELATED LARGER)
	if(NOT EXISTS "${${INPUT}}")
		message(FATAL_ERROR "Missing ${INPUT} corpus fixture: ${${INPUT}}")
	endif()
	execute_process(
		COMMAND "${NM_TOOL}" -g "${${INPUT}}"
		RESULT_VARIABLE RESULT
		OUTPUT_VARIABLE SYMBOLS_${INPUT})
	if(NOT RESULT EQUAL 0)
		message(FATAL_ERROR "nm failed for ${INPUT} corpus fixture")
	endif()
	foreach(SYMBOL corpus_shared_mix corpus_versioned corpus_patch_target)
		if(NOT SYMBOLS_${INPUT} MATCHES "${SYMBOL}")
			message(FATAL_ERROR "${INPUT} corpus fixture lacks ${SYMBOL}")
		endif()
	endforeach()
endforeach()

if(SYMBOLS_REFERENCE MATCHES "corpus_added" OR SYMBOLS_CHANGED MATCHES "corpus_added")
	message(FATAL_ERROR "corpus_added leaked into a fixture that should not contain it")
endif()
if(SYMBOLS_REMOVED MATCHES "corpus_removable")
	message(FATAL_ERROR "REMOVED corpus fixture still contains corpus_removable")
endif()
if(NOT SYMBOLS_RENAMED MATCHES "corpus_renamed"
	OR SYMBOLS_RENAMED MATCHES "corpus_stable_named")
	message(FATAL_ERROR "RENAMED corpus fixture has the wrong stable function symbol")
endif()
foreach(INPUT VULNERABLE FIXED INDEPENDENT UNRELATED)
	if(NOT SYMBOLS_${INPUT} MATCHES "corpus_patch_target")
		message(FATAL_ERROR "${INPUT} corpus fixture lacks corpus_patch_target")
	endif()
endforeach()
if(NOT SYMBOLS_LARGER MATCHES "corpus_larger_component")
	message(FATAL_ERROR "LARGER corpus fixture lacks corpus_larger_component")
endif()
if(NOT SYMBOLS_ADDED MATCHES "corpus_added")
	message(FATAL_ERROR "ADDED corpus fixture lacks corpus_added")
endif()
